# Caddyfile for the Understoria deployment.
#
# Single-domain layout: the PWA is served at `/` and the community node
# is reverse-proxied under `/api/*`. Members configure their PWA with
# `https://<DOMAIN>/api` as the community node URL; peer nodes in
# `PEER_NODE_URLS` use the same prefix.
#
# Caddy auto-acquires a Let's Encrypt cert for {$DOMAIN} on first
# launch and renews it. Email is required for revocation / expiry
# notifications.

{
	email {$ACME_EMAIL}
	# Production ACME endpoint; for first-time experiments uncomment
	# the staging line and comment the prod default so you don't hit
	# Let's Encrypt rate limits while debugging DNS.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$DOMAIN} {
	encode gzip zstd

	# Conservative security headers.
	#
	# CSP is locked down to same-origin everything plus one sha256 hash
	# for the inline theme/density bootstrap script in `index.html`
	# (the FOUC defense that runs before the page paints — moving it
	# to an external file would cost a blocking roundtrip and defeat
	# its purpose). If you edit `apps/web/index.html`, you MUST refresh
	# the hash with `scripts/csp-hash.sh` and re-deploy.
	#
	# style-src includes 'unsafe-inline' because React's `style={{...}}`
	# emits `style="..."` attributes (used for dynamic widths in
	# BreadthBar, milestone progress, etc.) and CSP3's 'unsafe-hashes'
	# directive doesn't have broad enough browser support yet to be
	# our floor. CSS injection is materially less weaponizable than
	# script injection, so this is the right cost.
	#
	# media-src includes blob: for voice notes and voice posts
	# (docs/message-relay.md §10, docs/voice-board.md): audio is
	# decrypted/fetched into memory and played through a blob: object
	# URL so the recording never exists at a fetchable same-origin URL.
	# Without this directive media falls back to default-src 'self' and
	# every player fails with "could not be played on this device" —
	# only in production, since dev servers send no CSP.
	#
	# Permissions-Policy allows microphone for THIS origin only
	# (microphone=(self)) — the voice recorder needs getUserMedia.
	# A bare microphone=() blocks recording outright in Chromium
	# browsers; iOS Safari ignores the header for top-level pages,
	# which is how the gap shipped unnoticed.
	#
	# 'wasm-unsafe-eval' (script-src) + blob: (worker-src) exist for
	# on-device transcription (docs/transcription-plan.md D5): the
	# speech engine compiles WASM inside a worker that its own bundled
	# chunk spawns from a blob: URL. 'wasm-unsafe-eval' permits ONLY
	# WebAssembly compilation — JS eval stays banned ('unsafe-eval' is
	# NOT granted) — and a blob: worker inherits this same CSP, so
	# neither directive opens remote code loading. The app probes for
	# these at runtime and degrades honestly on deployments that
	# haven't picked them up yet.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(self), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-lvEa/iIXgn2+Np2mTOvhBGRQj/6AoDgkHgQCJFaQplo='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Federation + PWA traffic to the community node. The strip_prefix
	# means /api/posts → /posts on the upstream, which matches the
	# server's route layout and lets the PWA + peer nodes use one URL
	# (`https://DOMAIN/api`) as their `communityNodeUrl` /
	# `PEER_NODE_URLS` entry.
	handle_path /api/* {
		reverse_proxy understoria:8787 {
			# Health-check the same /health endpoint the container's
			# HEALTHCHECK uses.
			health_uri /health
			health_interval 30s
			health_timeout 5s
		}
	}

	# Static PWA. The web-build container drops the dist into the
	# shared `web-dist` volume; Caddy serves from it.
	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}

	# Access logs are DISCARDED by default: they would carry every
	# member's IP, request path, and user agent into `docker compose
	# logs` on the host — exactly what a seized machine should not
	# yield, and what the operator guide (§9) and threat model (§6)
	# promise it does not. The node's own pino lines (method-only,
	# no IPs) still reach stdout. For short-lived triage, swap in the
	# stanza below, then put the discard back.
	log {
		output discard
	}
	# log {
	# 	output stdout
	# 	format console
	# }
}

# Onion front door (docs/tor-onion.md) — reachable ONLY from the tor
# sidecar: compose never publishes port 8080, so without the "onion"
# profile this listener is dead config. Plain HTTP by design — Tor
# itself provides transport encryption and endpoint authentication
# (the .onion address IS the key), so there's no ACME and no HSTS
# here; HSTS from the app server is actively stripped below because
# a Strict-Transport-Security header on an http:// onion origin is
# at best noise and at worst breaks Tor Browser variants that honor
# it. Same CSP as the clearnet vhost, verbatim.
#
# Access logs stay on stdout here (unlike the clearnet discard):
# every visitor arrives from the tor sidecar's address, so there are
# no member IPs to leak — and the line log is the only way to see
# the onion path is alive at all.
http://:8080 {
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(self), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-lvEa/iIXgn2+Np2mTOvhBGRQj/6AoDgkHgQCJFaQplo='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	handle_path /api/* {
		reverse_proxy understoria:8787 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			# The app server (helmet) sets HSTS on every response;
			# fine on the clearnet vhost, wrong on an http onion.
			header_down -Strict-Transport-Security
			# Marks onion-lane requests for the server's dedicated
			# rate-limit bucket (shipped in a later phase; the header
			# is inert until ONION_RATE_LIMIT_MAX is configured).
			# Spoof-proof: only Caddy can set it on this path, and
			# clearnet clients can't guess the secret.
			header_up X-Understoria-Onion {$ONION_MARK_SECRET}
		}
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
